--  Test fixture for lal-mcp. Uses non-default file naming on purpose.
project Fixture is

   type Build_Kind is ("debug", "release");
   Build : Build_Kind := external ("BUILD", "debug");

   for Source_Dirs use ("src");
   for Object_Dir use "obj/" & Build;
   for Main use ("main_proc.2.ada");

   package Naming is
      for Spec_Suffix ("Ada") use ".1.ada";
      for Body_Suffix ("Ada") use ".2.ada";
      for Separate_Suffix use ".2.ada";
      for Dot_Replacement use "__";
      --  Explicit file names for one unit
      for Spec ("Utils") use "utils_spec.ada";
      for Body ("Utils") use "utils_body.ada";
   end Naming;

end Fixture;
