# Settings for one lal-mcp service instance: /etc/lal-mcp/<name>.env, started with
#   systemctl enable --now lal-mcp@<name>
# Mode 0600, owned by root: it may hold the token. systemd reads it as root.
# Format: VAR=value, one per line, no `export`, no shell expansion.

# Repository root (required). The server runs there, so its .lal-mcp.toml is used,
# and answers give paths relative to it.
LAL_MCP_WORKSPACE=/ws

# Normally unset: the project and scenario variables come from the repository's
# .lal-mcp.toml (use BASE_DIR = "{workspace}" there for a path into the repository).
# Extra server arguments override it, split like a shell command line. A path with spaces:
# double quotes around the whole value, single quotes around the path,
#   LAL_MCP_ARGS="-P '/srv/my repo/mission.gpr' -XBUILD=debug"
#LAL_MCP_ARGS=

# Bind address and port. 127.0.0.1 accepts only local clients. Anything else
# (0.0.0.0 in a container, so the published port works) requires a token.
LAL_MCP_HOST=127.0.0.1
LAL_MCP_PORT=8765

# Bearer token clients must send (Authorization: Bearer <token>). run_lal executes Python
# in the server, so treat the port like a shell. Either the token itself...
#LAL_MCP_TOKEN=change-me
# ...or a file that holds it, readable by the lal-mcp user (e.g. a podman secret).
#LAL_MCP_TOKEN_FILE=/run/secrets/lal-mcp-token

# GNAT Pro + Libadalang install prefix (install.sh default).
GNATPRO_PREFIX=/opt/gnatpro/26.1
